# KORA Roasters — Environment Configuration Example
# Copy this file to `.env.local` and fill in your Supabase project details.
# Never commit `.env.local` or expose secret/service-role keys in browser code.

# Data mode switch:
# - "mock" (default): uses browser localStorage and fictional seed data
# - "supabase": connects to your Supabase project (products, RPC order flow, Supabase Auth + RLS)
NEXT_PUBLIC_KORA_DATA_MODE=mock

# Public Supabase project credentials (safe for browser/server client with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
